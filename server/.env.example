DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4200
CLIENT_ORIGIN="http://localhost:5175"
# Public base URL this server is reachable at — used only to render the
# copy-pasteable webhook URL / curl command in the UI. Point it at your
# deployed domain in production.
PUBLIC_API_URL="http://localhost:4200/api"
# Set to a cron expression (e.g. "0 */3 * * *") in the deployed demo to
# auto-reset seed data every 3 hours. Leave unset for local dev so your data
# (and any workflow runs you trigger) persists.
DEMO_RESEED_CRON=
