# Postgres connection string. Locally this can be your own postgres instance;
# on Vercel it's the pooled connection string from Neon / Vercel Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/syncflow?schema=public"

JWT_SECRET="change-me-in-production"
PORT=4200
CLIENT_ORIGIN="http://localhost:5175"

# Shared secret for the cron-triggered endpoints (/api/cron/*). Vercel Cron
# sends it automatically as "Authorization: Bearer $CRON_SECRET" once this is
# set in the project's environment variables. With no value set, those
# endpoints reject every request — they rewrite the whole database.
CRON_SECRET=

# LOCAL DEV ONLY: a cron expression (e.g. "0 */3 * * *") that reseeds demo data
# in-process. Production uses Vercel Cron against /api/cron/reseed instead.
DEMO_RESEED_CRON=
